# ENVIRONMENT
IS_PRODUCTION=0


# DATABASE (PostgreSQL)
DB_USERNAME=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spectuel


# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=password


# HTTP Redis Database (for API sessions, tokens, etc.)
HTTP_REDIS_DB=0


# Redis Key Prefixes for HTTP/API
REDIS_EMAIL_VERIFICATION_KEY_PREFIX=email_verification:
REDIS_CHANGE_USERNAME_KEY_PREFIX=change_username:
REDIS_CHANGE_EMAIL_KEY_PREFIX=change_email:
REDIS_CHANGE_PASSWORD_KEY_PREFIX=change_password:
REDIS_WS_TOKEN_PREFIX=ws_token:
REDIS_WS_TOKEN_TTL_SECS=10
REDIS_CANDLE_CACHE_PREFIX=candle_cache:


# Engine Redis Database (for balance management, escrow, etc.)
ENGINE_REDIS_DB=1


# Redis Key Prefixes for Engine
REDIS_CASH_BALANCE_PREFIX=cash_balance:
REDIS_CASH_ESCROW_PREFIX=cash_escrow:
REDIS_CASH_BALANCE_HASH_PREFIX=cash_balance_logs:
REDIS_CASH_ESCROW_HASH_PREFIX=cash_escrow_logs:


# KAFKA
KAFKA_HOST=localhost
KAFKA_PORT=9092


# Kafka Topics
KAFKA_ENGINE_EVENTS_TOPIC=engine_events
KAFKA_COMMANDS_TOPIC=cosmmands
KAFKA_BALANCE_EVENTS_TOPIC=balance_events
KAFKA_ORDER_EVENTS_TOPIC=order_events
KAFKA_INSTRUMENT_EVENTS_TOPIC=instrument_events


# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGO=HS256
JWT_EXPIRY_SECS=604800


# Password Hashing
PW_HASH_SALT=your-password-hash-salt-change-in-production


# Encryption (for sensitive data)
ENCRYPTION_KEY=your-encryption-key-32-bytes-long
ENCRYPTION_IV_LEN=12


# EMAIL SERVICE (Brevo)
BREVO_API_KEY=your-brevo-api-key
CUSTOMER_SUPPORT_EMAIL=support@yourdomain.com


# Heartbeat Server (monitors engine health)
HEARTBEAT_SERVER_HOST=localhost
HEARTBEAT_SERVER_PORT=8001
HEARTBEAT_ITMEOUT=5.0
HEARTBEAT_REGISTER_TIMEOUT=2.0


# System User ID (for system-generated events)
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000


# New User Command ID (for user registration events)
NEW_USER_COMMAND_ID=00000000-0000-0000-0000-000000000001
